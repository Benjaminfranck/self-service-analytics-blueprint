# Copy to .env and adjust. NEVER commit a real .env (it's git-ignored).
# Docker-compose path (default):
WAREHOUSE_DSN=postgresql://postgres:postgres@localhost:5432/analytics
# No-docker local path (scripts/local_pg.sh prints the exact DSN, usually port 55432):
# WAREHOUSE_DSN=postgresql://postgres@localhost:55432/analytics

READ_ONLY=true
DEMO_TENANT=acme
STATEMENT_TIMEOUT_MS=5000
